# Flask
SECRET_KEY=change-this-to-a-random-64-char-string
SITE_BASE_URL=https://lithophane.qualwiz.com

# SMTP (Gmail recommended — use an App Password, not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Lithophane Studio <your-gmail@gmail.com>

# Razorpay
RZP_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RZP_WEBHOOK_SECRET=your-webhook-secret

# Razorpay Plan IDs (create once in Razorpay dashboard → Subscriptions → Plans)
RZP_PLAN_PLUS_MONTHLY=plan_xxxxxxxxxxxxxxxx
RZP_PLAN_PLUS_YEARLY=plan_xxxxxxxxxxxxxxxx
RZP_PLAN_PRO_MONTHLY=plan_xxxxxxxxxxxxxxxx
RZP_PLAN_PRO_YEARLY=plan_xxxxxxxxxxxxxxxx

# Admin Panel
ADMIN_PASSWORD=choose-a-strong-admin-password
